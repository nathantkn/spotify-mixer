# Track data provider: "reccobeats" (default) or "mock" (offline, built-in library)
VITE_TRACK_PROVIDER=reccobeats
# ReccoBeats base URL. Default "/reccobeats" goes through the Vite dev/preview proxy.
# For a static deploy, point this at the API directly (if it allows your origin) or at your own proxy.
# VITE_RECCOBEATS_URL=https://api.reccobeats.com
