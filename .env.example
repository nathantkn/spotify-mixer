# These are server-side only. Never prefix them with VITE_, which would bundle them into the browser app.

# Spotify Web API (developer.spotify.com): finds songs and album art
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

FREQBLOG_API_KEY=

# Gemini (Google AI Studio): recommendation ideas, built from GetSongBPM data only
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Browser-side: "mock" uses the built-in 18-track library and no APIs
# VITE_TRACK_PROVIDER=mock